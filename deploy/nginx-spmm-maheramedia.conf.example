server {
    listen 80;
    server_name spmm.maheramedia.com;

    return 301 https://spmm.maheramedia.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name spmm.maheramedia.com;

    root /var/www/spmm/public;
    index index.php index.html;

    ssl_certificate /etc/letsencrypt/live/spmm.maheramedia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/spmm.maheramedia.com/privkey.pem;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_param HTTP_X_FORWARDED_SSL on;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
